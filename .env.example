# Copy to .env.local and fill with your own values. Never commit real secrets.

# Supabase — project URL + keys (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, keep secret

# Admin product manager (/admin)
ADMIN_PASSWORD=choose-a-strong-unique-password
ADMIN_SESSION_SECRET=long-random-string-used-to-sign-the-session-cookie
